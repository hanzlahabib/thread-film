{
  "name": "thread-film",
  "version": "0.1.0",
  "description": "Product films where one drawn line travels through your real screens. A Remotion engine driven by two files: a theme and a journey.",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "compositions": "remotion compositions src/index.ts",
    "validate": "tsx scripts/validate.ts",
    "typecheck": "tsc --noEmit",
    "render:16x9": "remotion render src/index.ts film-16x9 out/film-16x9.mp4 --codec=h264 --crf=18 --concurrency=2",
    "render:9x16": "remotion render src/index.ts film-9x16 out/film-9x16.mp4 --codec=h264 --crf=18 --concurrency=2",
    "render:demo": "remotion render src/index.ts film-16x9 out/demo-dark.mp4 --codec=h264 --crf=18 --concurrency=2 && remotion render src/index.ts film-16x9-light out/demo-light.mp4 --codec=h264 --crf=18 --concurrency=2",
    "render:screens": "node scripts/render-screens.mjs",
    "gif": "bash scripts/make-gifs.sh"
  },
  "dependencies": {
    "@remotion/cli": "4.0.486",
    "@remotion/google-fonts": "4.0.486",
    "@remotion/media-utils": "4.0.486",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.486"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "puppeteer-core": "25.17.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  }
}
